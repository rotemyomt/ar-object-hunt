# ---- Server ----
# Port the Node server listens on (serves the API, Socket.IO and, in production, the built client).
PORT=3001
# Comma-separated list of allowed browser origins for Socket.IO in production.
# Leave empty to allow same-origin only (the recommended setup: server serves the client).
CORS_ORIGINS=
# Rooms with no activity are deleted after this many minutes.
ROOM_IDLE_TIMEOUT_MIN=15
# NODE_ENV=production enables static serving of client/dist.
NODE_ENV=development

# ---- Client (Vite; only VITE_* vars are exposed to the browser — never put secrets here) ----
# Override the Socket.IO server URL. Leave empty to use the same origin (dev proxy / production).
VITE_SERVER_URL=
